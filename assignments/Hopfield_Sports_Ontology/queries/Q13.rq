PREFIX sports: <http://www.example.org/sports-ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Question: List all recorded coaches of tennis teams.
SELECT DISTINCT ?coach ?team
WHERE {
  ?team a/rdfs:subClassOf* sports:SportsTeam ;
        sports:playsSport sports:Tennis ;
        sports:hasCoach ?coach .
}
ORDER BY ?coach ?team
