    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nce98eca7f2e84e24aef2eaf1b96af5e8">
        <owl:onProperty rdf:resource="http://www.example.org/sports-ontology#homeTeam"/>
