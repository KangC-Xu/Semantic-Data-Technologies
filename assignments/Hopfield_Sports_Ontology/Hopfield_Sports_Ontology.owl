  <owl:Class rdf:about="http://www.example.org/sports-ontology#FootballAthlete">
    <rdfs:label xml:lang="en">Football Athlete</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/sports-ontology#Athlete"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N37545b4cbde249f28a55116ccf760f2e">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.example.org/sports-ontology#Athlete"/>
          <owl:Restriction rdf:nodeID="Nd2433ea4dbfe42489f53c0a466cd0102">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#participatesIn">
                <rdfs:label xml:lang="en">participates In</rdfs:label>
                <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Athlete"/>
                <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Sport"/>
                <rdfs:subPropertyOf rdf:resource="http://www.example.org/sports-ontology#belongToSport"/>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:hasValue>
              <owl:NamedIndividual rdf:about="http://www.example.org/sports-ontology#Football">
                <rdf:type rdf:resource="http://www.example.org/sports-ontology#FootballSport"/>
                <rdf:type rdf:resource="http://www.example.org/sports-ontology#TeamSport"/>
                <rdf:type rdf:resource="http://www.example.org/sports-ontology#Sport"/>
                <rdfs:label xml:lang="en">Football</rdfs:label>
                <sports:usesEquipment rdf:resource="http://www.example.org/sports-ontology#FootballBoots"/>
                <sports:usesEquipment rdf:resource="http://www.example.org/sports-ontology#FootballBall"/>
                <sports:requires rdf:resource="http://www.example.org/sports-ontology#FootballBoots"/>
                <sports:requires rdf:resource="http://www.example.org/sports-ontology#FootballBall"/>
                <sports:governedBy rdf:resource="http://www.example.org/sports-ontology#FIFA"/>
              </owl:NamedIndividual>
            </owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
