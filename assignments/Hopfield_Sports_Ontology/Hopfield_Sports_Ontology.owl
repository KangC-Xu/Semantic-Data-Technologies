>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#hasCoach">
    <rdfs:label xml:lang="en">has Coach</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#SportsTeam"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Coach"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#coachesTeam">
        <rdfs:label xml:lang="en">coaches Team</rdfs:label>
        <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Coach"/>
        <rdfs:range rdf:resource="http://www.example.org/sports-ontology#SportsTeam"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:comment xml:lang="en">A recorded historical coaching relationship. The time interval is represented by CoachingAssignment and no one-coach-per-team assumption is made.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#inCompetition">
    <rdfs:label xml:lang="en">in Competition</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Match"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Competition"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#participationAthlete">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">participation Athlete</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#AthleteParticipation"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Athlete"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#cityCountry">
    <rdfs:label xml:lang="en">city Country</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#City"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Country"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#playedInMatch">
    <rdfs:label xml:lang="en">played In Match</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Athlete"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Match"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.example.org/sports-ontology#isOfficial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">is Official</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Match"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#assignmentCoach">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">assignment Coach</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#CoachingAssignment"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Coach"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#trophySeries">
    <rdfs:label xml:lang="en">trophy Series</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Trophy"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#CompetitionSeries"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#assignmentTeam">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">assignment Team</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#CoachingAssignment"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#SportsTeam"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.example.org/sports-ontology#participatedIn">
    <rdfs:label xml:lang="en">participated In</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/sports-ontology#Athlete"/>
    <rdfs:range rdf:resource="http://www.example.org/sports-ontology#Competition"/>
    <rdfs:comment xml:lang="en">A roster or registration relationship. It does not imply that the athlete played in every match; actual match appearance uses playedInMatch.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="http://www.example.org/sports-ontology#SportsOntology">
    <dcterms:title xml:lang="en">Hopfield Sports Ontology</dcterms:title>
    <dcterms:creator>Hopfield</dcterms:creator>
    <owl:versionInfo>2.0 2026-10-25</owl:versionInfo>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-25T00:00:00</dcterms:created>
    <dcterms:description xml:lang="en">Built for MOD004979 from the two supplied question workbooks and the Week 1 and Week 2 teaching materials. The main entity IRIs from the desktop starter are retained, while sports relations are reorganised. Ages are calculated as of 2024-07-01; memberships and coaching assignments are time-scoped records. The Argentina 2022 World Cup roster and the Paris 2024 men's football teams are complete within the stated scope; other records are selected teaching data.</dcterms:description>
  </owl:Ontology>
